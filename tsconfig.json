{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    /* Path aliases for cleaner imports */
    "baseUrl": ".",
    "paths": {
      "@services/*": ["src/services/*"],
      "@stores/*": ["src/stores/*"],
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
